# Optional. The easiest way to add keys is the Settings screen (gear icon) in the app.
# Anything set here is used as a fallback when Settings has no value. Restart the server after editing.

# Password for Scout itself. Required when other computers reach Scout (a server, Vercel, a tunnel): everyone logs
# in with it once per browser. Without it Scout only answers this computer (http://localhost).
SCOUT_PASSWORD=

# AI: none needed for the free Local AI (set it up in Settings). Cloud AIs below are optional.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Your own GPU server (scripts/verda_setup.sh prints both values). Or set them in Settings -> Your GPU server.
GPU_SERVER_URL=
GPU_SERVER_API_KEY=

# YouTube Data API v3 (free, 10,000 quota units/day)
YOUTUBE_API_KEY=

# TikTok needs no key: Scout has its own scraper.

# Twitch (optional, free): dev.twitch.tv -> Your Console -> Register Your Application (OAuth redirect http://localhost,
# category Other) -> Client ID, then New Secret. Adds Twitch to searches.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Team chat (optional): when a repeating search finds new creators, Scout posts the best ones here.
# Slack: an incoming webhook (https://hooks.slack.com/services/...).
# Teams: a Workflows webhook ("Post to a channel when a webhook request is received").
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
# Where the team opens Scout, for the "Open Scout" link in those messages.
SCOUT_PUBLIC_URL=

# Advanced
# MAX_SCORE_PER_JOB=60
