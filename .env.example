# Optional. The easiest way to add keys is the Settings screen (gear icon) in the app.
# Anything set here is used as a fallback when Settings has no value. Restart the server after editing.

# AI: any one of these is enough. The optional "AI web scout" needs Claude.
ANTHROPIC_API_KEY=
# Only for organization-wide Claude keys ("not scoped to a workspace" error): wrkspc_...
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# YouTube Data API v3 (free, 10,000 quota units/day)
YOUTUBE_API_KEY=

# Apify token for TikTok + Instagram (free plan includes $5/month)
APIFY_TOKEN=

